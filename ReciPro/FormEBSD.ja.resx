  </data>
  <data name="trackBarLineWidth.ToolTip" xml:space="preserve">
    <value>菊池線の線幅(描画ペンの太さ)を設定します。</value>
  </data>
  <data name="labelLineWidth.Text" xml:space="preserve">
    <value>線の太さ</value>
  </data>
  <data name="labelLineWidth.ToolTip" xml:space="preserve">
